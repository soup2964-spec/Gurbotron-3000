# Fanvue API — Bearer JWT from your OAuth flow / developer app
FANVUE_ACCESS_TOKEN=
# Your creator account UUID (used to tell fan messages vs your replies)
FANVUE_CREATOR_UUID=
FANVUE_API_URL=https://api.fanvue.com
FANVUE_API_VERSION=2025-06-26

# SQLite database file (directory created automatically)
DATABASE_URL=sqlite:///./data/gurbotron.db

# Background polling when automation is enabled
POLL_INTERVAL_SECONDS=45

# Optional default PPV price in cents (USD) — omit or 0 to never send priced messages from automation rules
DEFAULT_PPV_PRICE_CENTS=
EXIT_MESSAGES_MIN=20
EXIT_MESSAGES_MAX=30
