# Copy to .env.local for Next.js (local dev)

DATABASE_URL="file:./data/next.db"

FANVUE_ACCESS_TOKEN=
FANVUE_CREATOR_UUID=

# Optional overrides
# FANVUE_API_URL=https://api.fanvue.com
# FANVUE_API_VERSION=2025-06-26

# Required in production for /api/cron/poll (Vercel Cron sends Authorization: Bearer ...)
CRON_SECRET=

# Optional automation tuning (matches Python defaults)
# DEFAULT_PPV_PRICE_CENTS=
# EXIT_MESSAGES_MIN=20
# EXIT_MESSAGES_MAX=30

# After a non-priced stub/LLM reply, send this Fanvue template UUID as a follow-up
# AUTO_ATTACH_PPV_TEMPLATE_UUID=
